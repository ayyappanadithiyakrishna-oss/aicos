# ─── Mode ────────────────────────────────────────────────────────────────────
# DEMO (default) serves a deterministic, clearly labelled synthetic world.
# Live mode requires an explicit DEMO_MODE=false. Demo and live data never mix.
DEMO_MODE=true
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Persistence (optional) ──────────────────────────────────────────────────
# Postgres (e.g. Neon). Without it, live mode uses an ephemeral per-instance store
# and refreshes on demand at most every LIVE_REFRESH_SECONDS.
DATABASE_URL=
LIVE_REFRESH_SECONDS=300

# ─── Providers (live mode) ───────────────────────────────────────────────────
# SEC EDGAR: public data; fair access requires "Name contact@email" identification.
SEC_USER_AGENT=
# FRED/ALFRED: official observations + vintages (no survey consensus).
FRED_API_KEY=
# Financial Modeling Prep: content is shown publicly ONLY when your plan permits it.
FMP_API_KEY=
FMP_DISPLAY_LICENSE=          # set to "confirmed" only if your FMP terms allow public display
FMP_CONSENSUS_LICENSED=       # "true" only if consensus/estimates may be displayed
# Massive (formerly Polygon): personal tiers do not authorize public redistribution.
MASSIVE_API_KEY=
MASSIVE_DISPLAY_LICENSE=      # set to "confirmed" only with an appropriate commercial license

# ─── Model-assisted extraction (optional) ────────────────────────────────────
# Used only for extraction; never authors forecasts. Enable only if every content
# vendor agreement permits sending content to an external AI provider.
ANTHROPIC_API_KEY=
LLM_PROCESSING_ALLOWED=false
SIGNAL_LLM_MODEL=claude-opus-5-5

# ─── Jobs & operator endpoints ───────────────────────────────────────────────
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET". Use ≥16 random characters.
CRON_SECRET=
# Bearer token for POST /api/admin/ingest (manual ingest). ≥16 characters.
ADMIN_TOKEN=

# ─── Scorecard ───────────────────────────────────────────────────────────────
MIN_METRIC_SAMPLE=30

# Not wired in this build (documented for future work):
# OPTIONAL_AUTH_SECRET=
# OPTIONAL_EMAIL_PROVIDER_KEY=
# OPTIONAL_MONITORING_DSN=
